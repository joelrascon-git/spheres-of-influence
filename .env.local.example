# Copy to .env.local and fill in. Everything here is required to run the app.
# Supabase: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Comma-separated list of emails allowed to sign in. Empty = any email (dev only).
# Example: ALLOWED_EMAILS=you@factory.ai,colleague@factory.ai
ALLOWED_EMAILS=

# Later phases (AI, enrichment, direct Evaboot import, map):
# ANTHROPIC_API_KEY=
# SUMBLE_API_KEY=
# EVABOOT_API_KEY=
# MAPBOX_TOKEN=
